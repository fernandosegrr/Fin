// Prisma gestiona el ESQUEMA y las MIGRACIONES de la base de datos.
// A propósito, NO se usa Prisma Client para las consultas de la app en
// runtime (esas siguen en lib/supabase/*.ts vía supabase-js): toda la
// seguridad de esta app depende de Row Level Security por usuario
// (auth.uid() = user_id), y Prisma se conecta con un rol de Postgres que
// pasa por encima de RLS. Usar Prisma ahí abriría una fuga de datos entre
// usuarios. Prisma sí se usa en scripts/seed.ts: es un script de
// administración de confianza que corre fuera de cualquier sesión de
// usuario, exactamente el contexto donde tiene sentido saltarse RLS.
//
// auth.users (tabla de Supabase Auth) vive fuera de este schema a propósito:
// las columnas user_id de abajo son uuid planos, y la FK real hacia
// auth.users, además de las políticas RLS y el trigger, viven en SQL crudo
// dentro de prisma/migrations/ (Prisma no modela RLS/políticas nativamente).

generator client {
  provider = "prisma-client-js"
}

// La connection string vive en prisma.config.ts (Prisma 7 ya no la acepta
// aquí), no en este archivo.
datasource db {
  provider = "postgresql"
}

enum TipoCategoria {
  ingreso
  egreso

  @@map("tipo_categoria")
}

enum GrupoCategoria {
  fijo
  variable

  @@map("grupo_categoria")
}

model Categoria {
  id     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String          @map("user_id") @db.Uuid
  nombre String
  tipo   TipoCategoria
  grupo  GrupoCategoria?

  transacciones     Transaccion[]
  presupuestos      Presupuesto[]
  gastosRecurrentes GastoRecurrente[]

  familia    String?
  archivada  Boolean  @default(false)
  aliases    String[] @default([])
  naturaleza String?

  @@index([userId, tipo])
  @@map("categorias")
}

model Transaccion {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  categoriaId       String   @map("categoria_id") @db.Uuid
  monto             Decimal  @db.Decimal
  fecha             DateTime @default(now()) @db.Date
  /// Valores válidos: 'tarjeta' | 'efectivo' (CHECK constraint en la BD, no modelado aquí).
  metodoPago        String   @default("tarjeta") @map("metodo_pago")
  descripcion       String?
  /// Suscripción/gasto recurrente que originó esta transacción, si aplica.
  gastoRecurrenteId String?  @map("gasto_recurrente_id") @db.Uuid
  /// Cliente/proyecto al que se asocia un ingreso (opcional).
  clienteId         String?  @map("cliente_id") @db.Uuid
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz

  categoria       Categoria        @relation(fields: [categoriaId], references: [id])
  gastoRecurrente GastoRecurrente? @relation(fields: [gastoRecurrenteId], references: [id])
  cliente         Cliente?         @relation(fields: [clienteId], references: [id])

  naturaleza              String?
  cuentaId                String?   @map("cuenta_id") @db.Uuid
  cuentaDestinoId         String?   @map("cuenta_destino_id") @db.Uuid
  etiquetas               String[]  @default([])
  requiereRevision        Boolean   @default(false) @map("requiere_revision")
  motivoRevision          String?   @map("motivo_revision")
  interesBruto            Decimal?  @map("interes_bruto") @db.Decimal
  impuestoRetenido        Decimal?  @map("impuesto_retenido") @db.Decimal
  deudaLiquidadaEn        DateTime? @map("deuda_liquidada_en") @db.Date
  movimientoRelacionadoId String?   @map("movimiento_relacionado_id") @db.Uuid
  eliminadoEn             DateTime? @map("eliminado_en") @db.Timestamptz
  claveSolicitud          String?   @map("clave_solicitud") @db.Uuid
  actualizadoEn           DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz

  @@index([userId, fecha(sort: Desc)])
  @@index([userId, categoriaId])
  @@index([gastoRecurrenteId])
  @@index([clienteId])
  @@map("transacciones")
}

model Cliente {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  nombre   String
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz

  transacciones Transaccion[]

  @@unique([userId, nombre])
  @@index([userId, nombre])
  @@map("clientes")
}

/// Una meta de ahorro activa por usuario (el patrimonio total se compara contra el objetivo).
model MetaAhorro {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  nombre        String
  montoObjetivo Decimal   @map("monto_objetivo") @db.Decimal
  fechaLimite   DateTime? @map("fecha_limite") @db.Date
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  cuentaId String? @map("cuenta_id") @db.Uuid

  @@map("metas_ahorro")
}

model Presupuesto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoriaId String   @map("categoria_id") @db.Uuid
  montoLimite Decimal  @map("monto_limite") @db.Decimal
  /// Primer día del mes que presupuesta, p. ej. 2026-08-01.
  mes         DateTime @db.Date

  categoria Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([userId, categoriaId, mes])
  @@index([userId, mes])
  @@map("presupuestos")
}

model GastoRecurrente {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  nombre      String
  monto       Decimal  @db.Decimal
  diaCobro    Int      @map("dia_cobro")
  categoriaId String?  @map("categoria_id") @db.Uuid
  /// Valores válidos: 'tarjeta' | 'efectivo' (CHECK constraint en la BD, no modelado aquí).
  metodoPago  String   @default("tarjeta") @map("metodo_pago")
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz

  categoria     Categoria?    @relation(fields: [categoriaId], references: [id])
  transacciones Transaccion[]

  archivada Boolean @default(false)

  @@index([userId, diaCobro])
  @@map("gastos_recurrentes")
}

model Transferencia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  monto       Decimal  @db.Decimal
  /// Valores válidos: 'tarjeta' | 'efectivo' (CHECK constraint en la BD, no modelado aquí).
  origen      String
  destino     String
  fecha       DateTime @default(now()) @db.Date
  descripcion String?
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz

  cuentaOrigenId  String?   @map("cuenta_origen_id") @db.Uuid
  cuentaDestinoId String?   @map("cuenta_destino_id") @db.Uuid
  eliminadoEn     DateTime? @map("eliminado_en") @db.Timestamptz
  claveSolicitud  String?   @map("clave_solicitud") @db.Uuid
  actualizadoEn   DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz

  @@index([userId, fecha(sort: Desc)])
  @@map("transferencias")
}

model MensajeAsesor {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  /// Valores válidos: 'usuario' | 'asistente' (CHECK constraint en la BD, no modelado aquí).
  rol           String
  contenido     String
  /// Tokens de la llamada a OpenAI que generó este mensaje. Solo se llenan
  /// en mensajes de rol 'asistente' — visibilidad de costo, no lógica de negocio.
  tokensEntrada Int?     @map("tokens_entrada")
  tokensSalida  Int?     @map("tokens_salida")
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz

  solicitudId String? @map("solicitud_id") @db.Uuid

  @@index([userId, creadoEn])
  @@map("mensajes_asesor")
}

/// Hechos/preferencias que el Asesor IA decide recordar a largo plazo (vía la
/// tool guardar_nota_memoria), independiente del historial de mensajes — se
/// inyectan como lista corta en el system prompt en cada turno, en vez de
/// reenviar la conversación completa. Sin tabla de "hilos": user_id ya
/// identifica el hilo completo (uso personal, un solo hilo continuo).
model NotaMemoriaAsesor {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  contenido String
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz

  @@index([userId, creadoEn])
  @@map("notas_memoria_asesor")
}

/// Las FKs compuestas de propiedad, RLS e índices parciales se mantienen en SQL.
model CuentaFinanciera {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  codigo             String
  nombre             String
  tipo               String
  metodoPago         String    @map("metodo_pago")
  banco              String?
  excluidaDisponible Boolean   @default(false) @map("excluida_disponible")
  archivada          Boolean   @default(false)
  grupoRendimiento   String?   @map("grupo_rendimiento")
  rendimientoDesde   DateTime? @map("rendimiento_desde") @db.Date
  tasaAnual          Decimal   @default(0) @map("tasa_anual") @db.Decimal(8, 4)
  tasaExcedente      Decimal   @default(0) @map("tasa_excedente") @db.Decimal(8, 4)
  tasaSuperior       Decimal   @default(0) @map("tasa_superior") @db.Decimal(8, 4)
  retencionAnual     Decimal   @default(0) @map("retencion_anual") @db.Decimal(8, 4)
  limitePreferente   Decimal   @default(25000) @map("limite_preferente") @db.Decimal
  limiteSegundoTramo Decimal   @default(1000000) @map("limite_segundo_tramo") @db.Decimal
  plan               String?
  creadoEn           DateTime  @default(now()) @map("creado_en") @db.Timestamptz

  @@unique([userId, codigo])
  @@unique([id, userId])
  @@map("cuentas_financieras")
}

model CambioFinanciero {
  secuencia  BigInt   @id @default(autoincrement())
  id         String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  loteId     String   @map("lote_id") @db.Uuid
  entidad    String
  registroId String   @map("registro_id") @db.Uuid
  antes      Json?
  despues    Json?
  creadoEn   DateTime @default(now()) @map("creado_en") @db.Timestamptz

  @@map("cambios_financieros")
}

model LoteFinanciero {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  nombre    String
  revertido Boolean  @default(false)
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz

  @@map("lotes_financieros")
}

model SolicitudAsesor {
  id            String   @id @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  contenido     String
  estado        String   @default("procesando")
  acciones      Json     @default("[]")
  respuesta     String?
  mensajeId     String?  @map("mensaje_id") @db.Uuid
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz

  @@map("solicitudes_asesor")
}

model MesPresupuestado {
  userId String   @map("user_id") @db.Uuid
  mes    DateTime @db.Date

  @@id([userId, mes])
  @@map("meses_presupuestados")
}
