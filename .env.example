# Copia este archivo a .env.local y rellena los valores reales.
# .env.local NUNCA se commitea (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SEED_USER_ID=

# --- Prisma (esquema y migraciones — ver prisma/schema.prisma) ---
# Ambos se obtienen en el Dashboard de Supabase → Project Settings →
# Database → Connection String. Sustituye [YOUR-PASSWORD] por tu contraseña
# de base de datos (la de Postgres, NO las keys de arriba).

# Pooled (modo transacción, puerto 6543) — la usa Prisma Client en runtime
# (scripts/seed.ts). Requerida por el connection pooling de Supabase/pgbouncer.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Directa (puerto 5432) — la usa `prisma migrate` (el pooler en modo
# transacción no soporta los prepared statements que las migraciones necesitan).
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.TU-PROYECTO.supabase.co:5432/postgres

# --- Asesor IA (OpenAI) ---
# Se obtiene en https://platform.openai.com/api-keys.
# Sin esta variable, la pestaña "Asesor" muestra un error controlado en vez
# de romper el resto del dashboard (ver app/dashboard/asesor-actions.ts).
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
